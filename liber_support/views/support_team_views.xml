<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_support_team_form" model="ir.ui.view">
        <field name="name">liber.support.team.form</field>
        <field name="model">liber.support.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object"
                                class="oe_stat_button" icon="fa-inbox">
                            <field name="ticket_count" widget="statinfo"
                                   string="Open Tickets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Team name"/></h1>
                    </div>
                    <group>
                        <group name="routing">
                            <field name="company_id"/>
                            <label for="alias_name" string="Email Alias"/>
                            <div class="oe_inline" name="alias_def">
                                <field name="alias_name" class="oe_inline"/>@<field name="alias_domain_id" class="oe_inline"
                                       placeholder="e.g. edlab.press"/>
                            </div>
                            <field name="leader_id"
                                   widget="many2one_avatar_user"/>
                            <field name="member_ids"
                                   widget="many2many_avatar_user"/>
                        </group>
                        <group name="sla" string="SLA (working hours)">
                            <field name="resource_calendar_id"/>
                            <field name="sla_response_hours_normal"/>
                            <field name="sla_response_hours_urgent"/>
                            <field name="sla_resolution_hours_normal"/>
                            <field name="sla_resolution_hours_urgent"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_support_team_list" model="ir.ui.view">
        <field name="name">liber.support.team.list</field>
        <field name="model">liber.support.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="alias_id"/>
                <field name="company_id"/>
                <field name="leader_id" widget="many2one_avatar_user"/>
                <field name="ticket_count" string="Open Tickets"/>
            </list>
        </field>
    </record>

    <record id="action_support_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">liber.support.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
