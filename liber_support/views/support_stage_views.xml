<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_support_stage_list" model="ir.ui.view">
        <field name="name">liber.support.stage.list</field>
        <field name="model">liber.support.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="pause_sla"/>
                <field name="is_closed"/>
            </list>
        </field>
    </record>

    <record id="action_support_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">liber.support.stage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_support_tag_list" model="ir.ui.view">
        <field name="name">liber.support.tag.list</field>
        <field name="model">liber.support.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_support_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">liber.support.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
