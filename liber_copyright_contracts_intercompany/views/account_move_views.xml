<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Smart buttons linking the two sides of the intercompany pair -->
    <record id="view_move_form_edlab_intercompany" model="ir.ui.view">
        <field name="name">account.move.form.edlab.intercompany</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="edlab_is_interco_invoice" invisible="1"/>
                <field name="edlab_is_interco_bill" invisible="1"/>
                <field name="edlab_interco_mirror_move_id" invisible="1"/>
                <button name="action_open_interco_mirror_bills" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="edlab_interco_mirror_count == 0">
                    <field name="edlab_interco_mirror_count" widget="statinfo"
                           string="Mirror Bill"/>
                </button>
                <button name="action_open_interco_origin_invoice" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="not edlab_interco_mirror_move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Origin</span>
                        <span class="o_stat_text">Invoice</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
