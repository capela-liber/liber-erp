<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="import_xml_wizard_view" model="ir.ui.view">
            <field name="name">import.xml.file.wizard</field>
            <field name="model">import.xml.file</field>
            <field name="arch" type="xml">
                <form string="Import XML File">
                    <field name="state" invisible="1"/>
                    <group invisible="state == 'done'">
                        <field name="attachment_ids" widget="many2many_binary"
                               string="Files (ZIP or XML)"/>
                        <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <div invisible="state == 'done'" class="text-muted">
                        Drop the ZIP archives or the loose XML files. Notes
                        already in the panel are skipped.
                    </div>

                    <div invisible="state != 'done'">
                        <field name="summary" nolabel="1" readonly="1"
                               widget="text"/>
                        <group string="Files not imported"
                               invisible="not failure_details">
                            <field name="failure_details" nolabel="1"
                                   readonly="1" widget="text"/>
                        </group>
                    </div>

                    <footer>
                        <button name="import_xml_file" string="Import"
                                type="object" class="btn-primary"
                                invisible="state == 'done'"/>
                        <button name="action_view_panels" type="object"
                                string="View imported notes" class="btn-primary"
                                invisible="state != 'done' or not panel_ids"/>
                        <field name="panel_ids" invisible="1"/>
                        <button string="Close" class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="xml_import_wizard" model="ir.actions.act_window">
            <field name="name">Import XML File</field>
            <field name="res_model">import.xml.file</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="xml_import_wizard" id="xml_wizard_import"
            parent="liber_nfe_xml.menu_nfe_xml_panel" sequence="3"/>
    </data>
</odoo>
