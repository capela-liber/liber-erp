<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          O mapa mensal da prateleira. Roda TODO DIA e quase sempre não faz
          nada: quem decide se hoje é o dia é a configuração (Consignação ->
          Mapa de Consignação -> Mapa mensal por e-mail), não o intervalo do
          cron. Um cron mensal de verdade não existe no Odoo: "todo dia 5"
          não se escreve em interval_type — e um `months` a partir de hoje
          escorregaria de data a cada retomada.

          Às 11h UTC (8h de Brasília) porque isto sai para CLIENTE: o mapa deve
          chegar no começo do expediente de quem vai conferir a prateleira, e
          não às 3 da manhã junto com as rotinas internas.
        -->
        <record id="cron_send_shelf_maps" model="ir.cron">
            <field name="name">Consignment: e-mail the monthly shelf map</field>
            <field name="model_id" ref="liber_soc_agreements.model_consignment_agreement"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_shelf_maps()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=11, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
