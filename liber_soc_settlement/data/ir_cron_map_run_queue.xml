<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          O braço de fundo do wizard "RUN" (Consignação, Consignações,
          Operações, Mapa de Consignação). O clique só carimba
          `map_run_requested_at` e chama `_trigger()`, que pede ao Odoo para
          rodar isto o mais cedo possível: sem isso, quem clica esperaria o
          intervalo abaixo (1h) para o primeiro mapa sair.

          O intervalo de 1h é só uma rede de segurança (um `_trigger()`
          perdido, um restart no meio): no dia a dia quem dispara é o clique.
        -->
        <record id="cron_process_map_run_queue" model="ir.cron">
            <field name="name">Consignment: send maps queued by the RUN wizard</field>
            <field name="model_id" ref="model_consignment_settlement"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_map_run_queue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
