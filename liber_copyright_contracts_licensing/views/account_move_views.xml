<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The licensed contract on the invoice header, next to the customer:
         visible on customer invoices that have one, editable while in draft
         (a licence started from the contract arrives with it filled). -->
    <record id="view_move_form_licensing" model="ir.ui.view">
        <field name="name">account.move.form.copyright.licensing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="edlab_license_contract_id"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not edlab_license_contract_id"
                       readonly="state != 'draft'"
                       options="{'no_create': True}"/>
            </xpath>
            <!-- Which work a licensing line licenses: shown only on licences
                 (a contract with several works needs it chosen per line). -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="edlab_license_work_id" optional="show"
                       column_invisible="not parent.edlab_license_contract_id"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
