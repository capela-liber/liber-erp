<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sends the queued missions in the background, one author at a time,
         committing after each so a crash costs one author, not the batch.
         Triggered on the spot when a mission is queued; the interval is the
         safety net. -->
    <record id="cron_author_mission_queue" model="ir.cron">
        <field name="name">Author missions: send the queue</field>
        <field name="model_id" ref="model_edlab_author_mission"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_queue()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
