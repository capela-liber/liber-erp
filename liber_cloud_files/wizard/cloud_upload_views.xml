<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_liber_cloud_upload_form" model="ir.ui.view">
        <field name="name">liber.cloud.upload.form</field>
        <field name="model">liber.cloud.upload</field>
        <field name="arch" type="xml">
            <form>
                <field name="provider" invisible="1"/>
                <field name="allowed_folder_ids" invisible="1"/>
                <!-- Saying why there is nothing to choose beats a silent
                     empty list, and beats an error on the click. -->
                <div class="alert alert-warning" role="alert"
                     invisible="allowed_folder_ids">
                    You have no folder you may send files to. Uploading is
                    granted folder by folder: ask an administrator to add
                    you to the write group of the folder you need.
                </div>
                <group invisible="not allowed_folder_ids">
                    <field name="folder_id"/>
                    <field name="attachment_ids" widget="many2many_binary"
                           string="Files"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Upload"
                            class="btn-primary"
                            invisible="not allowed_folder_ids"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_liber_cloud_upload" model="ir.actions.act_window">
        <field name="name">Upload</field>
        <field name="res_model">liber.cloud.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
