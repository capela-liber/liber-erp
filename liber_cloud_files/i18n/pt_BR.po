#. module: liber_cloud_files
#: model_terms:ir.ui.view,arch_db:liber_cloud_files.view_liber_cloud_upload_form
msgid ""
"You have no folder you may send files to. Uploading is\n"
"                    granted folder by folder: ask an administrator to add\n"
"                    you to the write group of the folder you need."
msgstr ""
"Você não tem nenhuma pasta para onde enviar arquivos. O envio é\n"
"                    liberado pasta a pasta: peça a um administrador para\n"
"                    incluir você no grupo de escrita da pasta de que precisa."

#. module: liber_cloud_files
#: model_terms:ir.ui.view,arch_db:liber_cloud_files.cloud_file_gone
msgid ""
"was deleted, renamed or moved in the storage after the last sync, so there "
"is nothing to open."
msgstr "foi apagado, renomeado ou movido no armazenamento depois da última sincronização, e não há o que abrir."
