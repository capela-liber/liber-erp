<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.liber.in.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="default_taxes" position="after">
                <setting string="In Payment State"
                         help="Invoices stay In Payment until the payment meets the bank statement; disable to mark them Paid immediately.">
                    <field name="use_in_payment_state"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
