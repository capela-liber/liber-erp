<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The card "Invoices without order" adds two very different things:
         a note whose invoice was never created in Odoo, and a note whose
         invoice exists but is tied to no sales order. The list the card
         opens must let the reader split them without guessing row by row
         (the owner, 07/09/2026: "notas sem fatura nenhuma é muito estranho…
         seria legal um filtro pra isso"). -->
    <record id="view_nfe_xml_panel_search_ledger" model="ir.ui.view">
        <field name="name">nfe.xml.panel.search.ledger</field>
        <field name="model">nfe.xml.panel</field>
        <field name="inherit_id" ref="liber_nfe_xml.view_soc_xml_panel_search"/>
        <field name="arch" type="xml">
            <filter name="direction_in" position="after">
                <separator/>
                <filter name="sem_fatura" string="Without invoice"
                        domain="[('invoice_id', '=', False)]"
                        help="The XML is here and nobody created its invoice in Odoo"/>
                <filter name="fatura_sem_pedido" string="Invoice without order"
                        domain="[('invoice_id', '!=', False), ('invoice_id.invoice_line_ids.sale_line_ids', '=', False)]"
                        help="The invoice exists and none of its lines is tied to a sales order"/>
                <filter name="com_pedido" string="Tied to an order"
                        domain="[('invoice_id.invoice_line_ids.sale_line_ids', '!=', False)]"
                        help="The invoice pays at least one sales order line"/>
            </filter>
        </field>
    </record>
</odoo>
