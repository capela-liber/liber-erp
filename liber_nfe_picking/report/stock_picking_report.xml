<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Entra no menu Imprimir da lista de transferências, ao lado de
         "Guia de entrega" e "Rótulos": seleciona os movs, sai a DANFE. -->
    <record id="action_report_picking_danfe" model="ir.actions.report">
        <field name="name">Fiscal Notes</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">liber_nfe_picking.report_picking_danfe</field>
        <field name="print_report_name">'DANFE - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
