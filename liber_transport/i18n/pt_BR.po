#. module: liber_transport
#: model:mail.template,body_html:liber_transport.mail_template_pickup_request
msgid ""
"<div style=\"font-size: 13px;\">\n"
"                <t t-if=\"object.company_id.transport_pickup_request_text\">\n"
"                    <t t-out=\"object.company_id.transport_pickup_request_text\"/>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    <p>Prezados,</p>\n"
"                    <p>Solicitamos a <strong>coleta</strong> dos volumes\n"
"                       relacionados abaixo em nosso endereço:</p>\n"
"                </t>\n"
"                <p style=\"white-space: pre-line; margin: 8px 0;\"><strong><t t-out=\"object.company_id.name or ''\"/></strong><br/><t t-out=\"object.company_id.partner_id.contact_address or ''\"/></p>\n"
"                <table style=\"border-collapse: collapse; margin: 8px 0;\">\n"
"                    <tr>\n"
"                        <th style=\"text-align: left; border-bottom: 1px solid #ccc; padding: 4px 12px 4px 0;\">Referência</th>\n"
"                        <th style=\"text-align: left; border-bottom: 1px solid #ccc; padding: 4px 12px 4px 0;\">Pedido</th>\n"
"                        <th style=\"text-align: left; border-bottom: 1px solid #ccc; padding: 4px 12px 4px 0;\">Destinatário</th>\n"
"                        <th style=\"text-align: left; border-bottom: 1px solid #ccc; padding: 4px 12px 4px 0;\">Cidade/UF</th>\n"
"                        <th style=\"text-align: right; border-bottom: 1px solid #ccc; padding: 4px 12px 4px 0;\">Caixas</th>\n"
"                        <th style=\"text-align: right; border-bottom: 1px solid #ccc; padding: 4px 0;\">Peso (kg)</th>\n"
"                    </tr>\n"
"                    <t t-foreach=\"object.picking_ids\" t-as=\"picking\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 4px 12px 4px 0;\"><t t-out=\"picking.name or ''\"/></td>\n"
"                            <td style=\"padding: 4px 12px 4px 0;\"><t t-out=\"picking.origin or ''\"/></td>\n"
"                            <td style=\"padding: 4px 12px 4px 0;\"><t t-out=\"picking.partner_id.display_name or ''\"/></td>\n"
"                            <td style=\"padding: 4px 12px 4px 0;\"><t t-out=\"picking.partner_id.city or ''\"/><t t-if=\"picking.partner_id.state_id\">/<t t-out=\"picking.partner_id.state_id.code\"/></t></td>\n"
"                            <td style=\"text-align: right; padding: 4px 12px 4px 0;\"><t t-out=\"picking.box_count or ''\"/></td>\n"
"                            <td style=\"text-align: right; padding: 4px 0;\"><t t-set=\"peso\" t-value=\"picking.shipping_weight or picking.weight\"/><t t-out=\"'%.3f' % peso if peso else ''\"/></td>\n"
"                        </tr>\n"
"                    </t>\n"
"                    <tr>\n"
"                        <td colspan=\"4\" style=\"text-align: right; border-top: 1px solid #ccc; padding: 4px 12px 4px 0;\"><strong>Total</strong></td>\n"
"                        <td style=\"text-align: right; border-top: 1px solid #ccc; padding: 4px 12px 4px 0;\"><strong><t t-out=\"object.total_box_count or ''\"/></strong></td>\n"
"                        <td style=\"text-align: right; border-top: 1px solid #ccc; padding: 4px 0;\"><strong><t t-out=\"'%.3f' % object.total_weight if object.total_weight else ''\"/></strong></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>Por favor, respondam este e-mail confirmando a data da\n"
"                   coleta, citando a referência <strong><t t-out=\"object.name or ''\"/></strong>.</p>\n"
"                <p>Atenciosamente,<br/><t t-out=\"object.company_id.name or ''\"/></p>\n"
"            </div>\n"
"        "
msgstr ""

