<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- COL/ano/00001: o número que se cita ao telefone com a transportadora. -->
    <record id="seq_pickup_request" model="ir.sequence">
        <field name="name">Pickup Request (COL)</field>
        <field name="code">liber.transport.pickup.request</field>
        <field name="prefix">COL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
