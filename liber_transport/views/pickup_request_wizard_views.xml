<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pickup_request_wizard_form" model="ir.ui.view">
        <field name="name">liber.transport.pickup.wizard.form</field>
        <field name="model">liber.transport.pickup.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Pickup">
                <div class="alert alert-warning" role="alert"
                     invisible="not no_carrier_picking_ids">
                    <strong>No carrier:</strong> these delivery orders have no
                    carrier set and will be left out of the request.
                    <field name="no_carrier_picking_ids" widget="many2many_tags"
                           readonly="1" nolabel="1"/>
                </div>
                <!-- readonly + force_save: as linhas nascem do default_get e o
                     cliente não pode mexer nelas — sem isso, um clique na
                     linha abria um form automático da linha (que quebra) e o
                     salvamento podia mandar um create sem carrier_id. O
                     force_save garante que os grupos ainda viajam no save. -->
                <field name="line_ids" nolabel="1" readonly="1" force_save="1">
                    <list decoration-danger="not email" create="0" edit="0"
                          delete="0" no_open="1">
                        <field name="carrier_id"/>
                        <field name="partner_id"/>
                        <field name="contact_id"/>
                        <field name="email"/>
                        <field name="box_count" sum="Caixas"/>
                        <field name="weight" sum="Peso"/>
                        <field name="picking_ids" widget="many2many_tags"/>
                        <field name="company_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button string="Send" name="action_send" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pickup_request_wizard" model="ir.actions.act_window">
        <field name="name">Request Pickup</field>
        <field name="res_model">liber.transport.pickup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
