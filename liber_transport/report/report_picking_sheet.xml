<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Entra no menu Imprimir da lista de transferências, ao lado de
         "Operações de separação" (o do core continua lá: quem quiser a folha
         antiga, tem). -->
    <record id="action_report_picking_sheet" model="ir.actions.report">
        <field name="name">Picking</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">liber_transport.report_picking_sheet</field>
        <field name="report_file">liber_transport.report_picking_sheet</field>
        <field name="print_report_name">'Picking - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- O quadradinho de conferência. Desenhado, nunca o caractere ☐: o
         gerador de PDF troca glifo de fonte sem avisar e some com ele. -->
    <template id="report_picking_check">
        <span style="display:inline-block; width:11px; height:11px; border:1px solid #333; background-color:#ffffff;"/>
    </template>

    <!-- A tabela das duas folhas: quadradinho, posição, título, quantidade,
         peso. Recebe `sheet_lines` e `sheet_indicative`. -->
    <template id="report_picking_table">
        <table style="width:100%; border-collapse:collapse; font-size:11px;">
            <thead>
                <tr style="background-color:#2c3e50; color:#ffffff;">
                    <th style="width:26px; padding:6px 8px;"/>
                    <th style="text-align:left; padding:6px 10px; font-weight:600; width:105px;">Posição</th>
                    <th style="text-align:left; padding:6px 10px; font-weight:600;">Título</th>
                    <th style="text-align:right; padding:6px 10px; font-weight:600; width:60px;">Qtd.</th>
                    <th style="text-align:right; padding:6px 10px; font-weight:600; width:80px;">Peso</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="sheet_lines" t-as="line"
                    t-att-style="'border-bottom:1px solid #e6e6e6; background-color:' + ('#f7f9fa' if line_index % 2 else '#ffffff') + ';'">
                    <td style="padding:6px 8px; text-align:center;">
                        <t t-call="liber_transport.report_picking_check"/>
                    </td>
                    <td style="padding:6px 10px; font-family:monospace; font-size:12px; white-space:nowrap;">
                        <span t-if="line['position']" t-out="line['position']">EL-000137</span>
                        <span t-else="" style="color:#999;">—</span>
                    </td>
                    <td style="padding:6px 10px;">
                        <span t-out="line['product'].display_name">[9788565206112] Aqui tem coisa</span>
                    </td>
                    <td style="text-align:right; padding:6px 10px;">
                        <span t-out="int(line['qty']) if line['qty'] == int(line['qty']) else line['qty']">10</span>
                    </td>
                    <td style="text-align:right; padding:6px 10px;">
                        <span t-if="line['has_weight']" t-out="'%.2f kg' % line['weight']">1,20 kg</span>
                        <span t-else="" style="color:#999;">—</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <!-- O rodapé de conferência: totais e o peso com o seu quadradinho. -->
    <template id="report_picking_totals">
        <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:2px;">
            <tr style="border-top:2px solid #2c3e50; background-color:#f0f3f5; font-weight:bold;">
                <td style="padding:8px 10px;">
                    <span t-out="sheet['titles_total']">3</span> títulos ·
                    <span t-out="int(sheet['qty_total'])">41</span> exemplares
                </td>
                <td style="text-align:right; padding:8px 10px;">
                    <t t-call="liber_transport.report_picking_check"/>
                    <span style="margin-left:6px;" t-out="totals_label">Peso do lote</span>
                    <span t-out="'%.2f kg' % sheet['weight_total']">12,40 kg</span>
                </td>
            </tr>
        </table>
        <p t-if="sheet['no_weight']" style="font-size:10px; color:#a94442; margin:6px 0 0 0;">
            Peso incompleto: <span t-out="sheet['no_weight']">2</span>
            <t t-if="sheet['no_weight'] == 1">título sem peso cadastrado</t>
            <t t-else="">títulos sem peso cadastrado</t>
            — a balança não vai fechar com este número.
        </p>
    </template>

    <!-- O que o sistema não reservou NÃO vira linha de coleta: linha com
         quadradinho é ordem de buscar, e mandar buscar o que não está
         reservado ou não acha nada na prateleira, ou embala exemplar que não
         está na entrega. Fica o aviso, sem posição e sem quadradinho: é
         problema de quem prepara, não de quem coleta. -->
    <template id="report_picking_shortfall">
        <p t-if="sheet['shortfall'] and sheet['shortfall']['titles']"
           style="font-size:10px; color:#a94442; margin:6px 0 0 0;">
            Entrega incompleta:
            <span t-out="int(sheet['shortfall']['qty'])">5</span>
            <t t-if="sheet['shortfall']['qty'] == 1">exemplar</t>
            <t t-else="">exemplares</t>
            de <span t-out="sheet['shortfall']['titles']">1</span>
            <t t-if="sheet['shortfall']['titles'] == 1">título</t>
            <t t-else="">títulos</t>
            sem reserva — o sistema não os separou.
        </p>
    </template>

    <template id="report_picking_sheet">
        <t t-call="web.html_container">

            <!-- 1. A folha do passeio, só quando há mais de uma entrega. -->
            <t t-if="batch">
                <t t-set="o" t-value="docs[0]"/>
                <t t-call="web.external_layout">
                    <!-- O padding solta o título do endereço da empresa, que o
                         layout do core encosta no começo da página. -->
                    <div class="page" style="padding-top:16px;">
                        <h2 style="margin:0 0 2px 0;">Picking</h2>
                        <p style="font-size:11px; color:#666; margin:0 0 12px 0;">
                            Tudo o que sai nestas
                            <span t-out="len(docs)">3</span> entregas, somado por
                            título e na ordem da prateleira — um passeio só.
                        </p>
                        <t t-call="liber_transport.report_picking_table">
                            <t t-set="sheet_lines" t-value="batch['lines']"/>
                        </t>
                        <t t-call="liber_transport.report_picking_totals">
                            <t t-set="sheet" t-value="batch"/>
                            <t t-set="totals_label">Peso do lote</t>
                        </t>
                        <p t-if="batch['incomplete_pickings']"
                           style="font-size:10px; color:#a94442; margin:6px 0 0 0;">
                            <t t-if="batch['incomplete_pickings'] == 1">
                                1 destas entregas tem item sem reserva
                            </t>
                            <t t-else="">
                                <span t-out="batch['incomplete_pickings']">2</span>
                                destas entregas têm item sem reserva
                            </t>
                            — o que falta está dito na folha do pedido, e não
                            entra neste passeio.
                        </p>
                        <p style="font-size:10px; color:#666; margin-top:10px;">
                            Entregas:
                            <span t-out="', '.join(docs.mapped('name'))">EL-VG/OUT/01868, EL-VG/OUT/01872</span>
                        </p>
                    </div>
                </t>
            </t>

            <!-- 2. As folhas dos pedidos, uma por entrega. -->
            <t t-foreach="sheets" t-as="sheet">
                <t t-set="o" t-value="sheet['picking']"/>
                <t t-call="web.external_layout">
                    <div class="page" style="padding-top:16px;">
                        <div class="row" style="margin-bottom:10px;">
                            <div class="col-7">
                                <h3 style="margin:0;">Entrega <span t-field="o.name">EL-VG/OUT/01868</span></h3>
                                <div t-if="o.partner_id" style="font-size:12px;">
                                    <span t-field="o.partner_id"/>
                                </div>
                                <div t-if="o.origin" style="font-size:11px; color:#666;">
                                    Pedido: <span t-field="o.origin"/>
                                </div>
                            </div>
                            <div class="col-5 text-end">
                                <div t-field="o.name"
                                     t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:220px;height:40px;'}">
                                    <div class="bg-light border-1 rounded p-2 text-muted text-center">(barcode)</div>
                                </div>
                            </div>
                        </div>
                        <div style="font-size:11px; color:#444; margin-bottom:8px;">
                            <span t-if="o.scheduled_date">
                                Data: <span t-field="o.scheduled_date" t-options="{'widget': 'date'}"/> ·
                            </span>
                            <span t-if="o.carrier_id">
                                Transportadora: <span t-field="o.carrier_id.name"/> ·
                            </span>
                            <span>Caixas: <span t-out="o.box_count or '—'">3</span></span>
                        </div>
                        <t t-call="liber_transport.report_picking_table">
                            <t t-set="sheet_lines" t-value="sheet['lines']"/>
                        </t>
                        <t t-call="liber_transport.report_picking_totals">
                            <t t-set="totals_label">Peso dos livros</t>
                        </t>
                        <t t-call="liber_transport.report_picking_shortfall"/>
                    </div>
                </t>
            </t>

        </t>
    </template>

</odoo>
