#. module: liber_metabrasil
#. odoo-python
#: code:addons/liber_metabrasil/models/product_template.py:0
msgid ""
"%(count)s books selected. Pricing them takes about %(minutes)s minute(s) of "
"calls to the printer, too long to wait on this screen. Select %(limit)s or "
"fewer, or use Settings > Metabrasil > Refresh Print Prices to sweep the "
"whole catalogue in the background."
msgstr ""
"%(count)s livros selecionados. Cotá-los leva cerca de %(minutes)s minuto(s) "
"de chamadas à gráfica, tempo demais para esperar nesta tela. Selecione %"
"(limit)s ou menos, ou use Definições > Metabrasil > Atualizar preços de "
"impressão para varrer o catálogo inteiro em segundo plano."

#. module: liber_metabrasil
#. odoo-python
#: code:addons/liber_metabrasil/models/sale_order.py:0
msgid ""
"%(order)s was not confirmed: these products are on the dropship route but "
"have no vendor, so nothing would be bought and nothing would ship.\n"
"\n"
"%(products)s\n"
"\n"
"Give them a vendor, or take them off the dropship route."
msgstr "%(order)s não foi confirmado: estes produtos estão na rota de dropship mas não têm fornecedor, então nada seria comprado e nada seria enviado.\n\n%(products)s\n\nDê um fornecedor a eles, ou tire-os da rota de dropship."

#. module: liber_metabrasil
#. odoo-python
#: code:addons/liber_metabrasil/models/product_template.py:0
msgid ""
"%(priced)s book(s) priced. %(no_price)s the printer knows but has not "
"priced, and %(unknown)s are not in your POD repository at all."
msgstr ""
"%(priced)s livro(s) com preço. %(no_price)s a gráfica conhece mas não "
"precificou, e %(unknown)s não estão no seu repositório POD."

#. module: liber_metabrasil
#: model:mail.template,body_html:liber_metabrasil.mail_template_metabrasil_printing
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <p>Olá <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                    <p>Boa notícia: os livros do seu pedido\n"
"                        <strong t-out=\"object.name or ''\"/> entraram em "
"produção\n"
"                        na gráfica e em breve serão despachados.</p>\n"
"                    <p>Avisaremos novamente assim que a entrega for "
"realizada.</p>\n"
"                    <p><t t-out=\"object.company_id.name or ''\"/></p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: liber_metabrasil
#: model:mail.template,body_html:liber_metabrasil.mail_template_metabrasil_delivered
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <p>Olá <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                    <p>Seu pedido <strong t-out=\"object.name or ''\"/> foi\n"
"                        entregue. Esperamos que aproveite a leitura!</p>\n"
"                    <p>Qualquer problema com a entrega, responda este e-"
"mail\n"
"                        que resolvemos.</p>\n"
"                    <p><t t-out=\"object.company_id.name or ''\"/></p>\n"
"                </div>\n"
"            "
