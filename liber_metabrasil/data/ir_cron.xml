<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_metabrasil_sync_status" model="ir.cron">
            <field name="name">Metabrasil: sync print order status</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_metabrasil_sync_status()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- The print-price ladder. Fortnightly because production cost is
             contracted and moves slowly; the point is that the price is
             already in the database when somebody opens a quote, not that it
             is current to the second. -->
        <record id="ir_cron_metabrasil_prices" model="ir.cron">
            <field name="name">Metabrasil: refresh print prices</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_metabrasil_refresh_prices()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_metabrasil_exceptions" model="ir.cron">
            <field name="name">Metabrasil: overdue print orders</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_metabrasil_exceptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
