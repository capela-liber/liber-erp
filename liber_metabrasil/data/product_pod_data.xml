<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- The tag the price sweep stamps on books the printer quotes. Ships
             ready-made because nobody should have to build it by hand; the
             name is editable and Settings can point at a different tag. -->
        <record id="product_tag_pod" model="product.tag">
            <field name="name">PoD</field>
            <field name="color">4</field>
        </record>
    </data>

    <data>
        <!-- Outside the noupdate block on purpose: Odoo skips those on
             upgrade, and a company created later would never get the tag.
             The call only fills companies that have none, so re-running it
             never overrides a tag somebody chose. -->
        <function model="res.company" name="_metabrasil_set_default_pod_tag"/>

        <!-- "Run it on these books now", from the product list: select the
             titles, Actions, done. The pilot mechanism for a sweep that
             otherwise covers the whole catalogue. -->
        <record id="action_metabrasil_refresh_prices" model="ir.actions.server">
            <field name="name">Dropship Price</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = records.action_metabrasil_refresh_prices()</field>
        </record>
    </data>
</odoo>
