<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A EQUIPE DO EVENTO é gente de fora da rotina da casa: entra para
         trabalhar uma feira e sai quando a mercadoria volta. Por isso ela tem
         um grupo próprio, e não o papel permanente de Feiras: o grupo carrega
         a regra que a prende ao evento dela, e o Comercial da casa (que não
         está neste grupo) continua enxergando tudo.

         Odoo soma as regras dos grupos de cada pessoa com OU. Quem está SÓ
         aqui vê o evento em que trabalha; quem também é do Comercial vê o
         resto por causa do outro grupo. -->
    <!-- O ATENDENTE VEM ANTES DO SUPERVISOR neste arquivo: o supervisor o cita em
         `implied_ids`, e o XML se lê de cima para baixo. Com a ordem
         trocada o upgrade passa (o id já existe da versão anterior) e a
         INSTALAÇÃO DO ZERO morre com "External ID not found". -->
    <!-- Quem só opera o balcão. Não é a "equipe do evento" (que enxerga o
         evento inteiro): é quem foi contratado para vender três dias, e a
         única tela dele é o caixa. O grupo existe para carregar a regra
         abaixo, que o prende AO CAIXA DELE. -->
    <record id="group_fair_cashier" model="res.groups">
        <field name="name">Fair attendant</field>
        <field name="privilege_id" ref="liber_fairs.privilege_fairs"/>
        <field name="implied_ids"
               eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <!-- O SUPERVISOR é circunstancial: ele toca o evento na praça e
         NÃO faz parte do planejamento. Por isso ele não herda mais o papel de
         Feiras da casa (`group_fair_user`), que traz grade, modelos e o
         cadastro inteiro junto. Quem decide o que vai, quando vai e quanto
         cada um ganha é quem planeja, e isso acontece antes de a feira
         existir na rua.

         Ele implica `base.group_user` porque sem isso não se escreve nem no
         chatter, e a conferência morre de AccessError. -->
    <record id="group_fair_field" model="res.groups">
        <field name="name">Fair supervisor</field>
        <field name="privilege_id" ref="liber_fairs.privilege_fairs"/>
        <!-- (6, 0, ...) e não (4, ...): somar só ACRESCENTA, e a implicação
             antiga (o papel de Feiras da casa) sobreviveria calada ao
             upgrade. O gerente continuaria vendo os modelos de grade. -->
        <field name="implied_ids"
               eval="[(6, 0, [ref('base.group_user'),
                              ref('liber_fairs_pos.group_fair_cashier')])]"/>
    </record>

    <data noupdate="1">
        <!-- A ATENDENTE sozinha na praça. A caixa de livro chega no meio do
             movimento, e esperar o gerente para conferir é deixar a carga na
             calçada. Ela vê a feira DELA (só leitura) e confere a chegada
             dela — e nada mais: nem grade, nem perda, nem outro evento. -->
        <record id="rule_fair_cashier_own_fair" model="ir.rule">
            <field name="name">Fair attendant: only their own events</field>
            <field name="model_id" ref="liber_fairs.model_event_fair"/>
            <field name="domain_force">[('cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_cashier'))]"/>
        </record>

        <record id="rule_fair_cashier_own_picking" model="ir.rule">
            <field name="name">Fair attendant: arrivals of their own events</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('fair_id.cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_cashier'))]"/>
        </record>

        <record id="rule_fair_cashier_own_register" model="ir.rule">
            <field name="name">Fair attendant: only their own register</field>
            <field name="model_id" ref="point_of_sale.model_pos_config"/>
            <field name="domain_force">[('fair_cashier_id.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_cashier'))]"/>
        </record>

        <record id="rule_fair_cashier_own_session" model="ir.rule">
            <field name="name">Fair attendant: only sessions of their register</field>
            <field name="model_id" ref="point_of_sale.model_pos_session"/>
            <field name="domain_force">[('config_id.fair_cashier_id.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_cashier'))]"/>
        </record>

        <!-- O SUPERVISOR ENTRA NO CAIXA DAS COLEGAS. Balcão travado, troco
             errado, venda pela metade: quem resolve isso é quem está na
             praça, e a regra do operador ("só o meu caixa") o impediria de
             chegar lá. A soma das regras é OU: o gerente vê o dele por uma
             regra e o dos outros por esta. -->
        <record id="rule_fair_lead_team_registers" model="ir.rule">
            <field name="name">Fair supervisor: every register of their events</field>
            <field name="model_id" ref="point_of_sale.model_pos_config"/>
            <field name="domain_force">[('fair_id.cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_field'))]"/>
        </record>

        <record id="rule_fair_lead_team_sessions" model="ir.rule">
            <field name="name">Fair supervisor: every session of their events</field>
            <field name="model_id" ref="point_of_sale.model_pos_session"/>
            <field name="domain_force">[('config_id.fair_id.cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_field'))]"/>
        </record>

        <record id="rule_fair_staff_own_event" model="ir.rule">
            <field name="name">Fair supervisor: only their own events</field>
            <field name="model_id" ref="liber_fairs.model_event_fair"/>
            <field name="domain_force">[('cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_field'))]"/>
        </record>

        <record id="rule_fair_staff_own_day" model="ir.rule">
            <field name="name">Fair supervisor: closings of their own events</field>
            <field name="model_id" ref="liber_fairs.model_event_fair_day"/>
            <field name="domain_force">[('fair_id.cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_field'))]"/>
        </record>

        <record id="rule_fair_staff_own_line" model="ir.rule">
            <field name="name">Fair supervisor: grid of their own events</field>
            <field name="model_id" ref="liber_fairs.model_event_fair_line"/>
            <field name="domain_force">[('fair_id.cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_field'))]"/>
        </record>

        <record id="rule_fair_staff_own_loss" model="ir.rule">
            <field name="name">Fair supervisor: losses of their own events</field>
            <field name="model_id" ref="liber_fairs.model_event_fair_loss"/>
            <field name="domain_force">[('fair_id.cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_field'))]"/>
        </record>

        <record id="rule_fair_staff_own_cashier" model="ir.rule">
            <field name="name">Fair supervisor: the team of their own events</field>
            <field name="model_id" ref="model_event_fair_cashier"/>
            <field name="domain_force">[('fair_id.cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_field'))]"/>
        </record>

        <!-- Recebimentos: a equipe confere a carga DELA. Movimento que não é
             de feira nenhuma não é assunto de quem está na praça. -->
        <record id="rule_fair_staff_own_picking" model="ir.rule">
            <field name="name">Fair supervisor: transfers of their own events</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('fair_id.cashier_ids.partner_id.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fair_field'))]"/>
        </record>
    </data>
</odoo>
