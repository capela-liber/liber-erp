#. module: liber_fairs_pos
#: model:ir.model.fields,help:liber_fairs_pos.field_pos_config__fair_id
msgid ""
"The fair this register belongs to. It sells from that fair's table, not from"
" the warehouse."
msgstr "A feira a que este caixa pertence. Ele vende a mesa daquela feira, não o armazém."

#. module: liber_fairs_pos
#. odoo-python
#: code:addons/liber_fairs_pos/models/event_fair.py:0
msgid ""
"The register %(caixa)s of %(feira)s still has an unpaid order. Finish or "
"cancel it in the Point of Sale, then ask for the return."
msgstr "O caixa %(caixa)s de %(feira)s ainda tem um pedido sem pagamento. Termine ou cancele no Ponto de Venda, e então peça o retorno."

#. module: liber_fairs_pos
#. odoo-python
#: code:addons/liber_fairs_pos/models/event_fair.py:0
msgid ""
"The register opens for a fair that is planned or already on the road. %s is "
"not."
msgstr "O caixa abre para feira planejada ou já na estrada. %s não é nenhuma das duas."

