#. module: liber_fairs_pos
#. odoo-python
#: code:addons/liber_fairs_pos/models/event_fair.py:0
msgid ""
"%(feira)s — cash register %(caixa)s opened. It sells from the table, not "
"from the warehouse."
msgstr "%(feira)s — caixa %(caixa)s aberto. Ele vende a mesa, não o armazém."

#. module: liber_fairs_pos
#. odoo-python
#: code:addons/liber_fairs_pos/models/event_fair.py:0
msgid "%(feira)s — register %(caixa)s closed with the return."
msgstr "%(feira)s — caixa %(caixa)s fechado com o retorno."

#. module: liber_fairs_pos
#. odoo-python
#: code:addons/liber_fairs_pos/models/event_fair.py:0
msgid ""
"%s has no bank or cash journal: the register cannot take money in a company "
"that has no place to put it."
msgstr "%s não tem diário de banco nem de caixa: o caixa não pode receber dinheiro numa empresa que não tem onde guardá-lo."

#. module: liber_fairs_pos
#. odoo-python
#: code:addons/liber_fairs_pos/models/event_fair.py:0
msgid ""
"%s has no warehouse, and the register needs one to hang the operation on."
msgstr "%s não tem armazém, e o caixa precisa de um para pendurar a operação."

#. module: liber_fairs_pos
#. odoo-python
#: code:addons/liber_fairs_pos/models/event_fair.py:0
msgid "%s says it has no cash register. Raise the number of registers first."
msgstr "%s diz não ter caixa nenhum. Aumente o número de caixas primeiro."

