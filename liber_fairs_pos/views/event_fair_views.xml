<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_fair_form_pos" model="ir.ui.view">
        <field name="name">event.fair.form.pos</field>
        <field name="model">event.fair</field>
        <field name="inherit_id" ref="liber_fairs.view_event_fair_form"/>
        <field name="arch" type="xml">
            <button name="action_return" position="before">
                <button name="action_open_pos" type="object"
                        string="Cash register" class="btn-secondary"
                        invisible="state not in ('planned', 'shipped')"
                        help="Opens one Point of Sale register per operator. They sell the copies on the table, not the warehouse stock."/>
            </button>
            <div name="button_box" position="inside">
                <button name="action_view_pos_orders" type="object"
                        class="oe_stat_button" icon="fa-shopping-basket"
                        invisible="pos_order_count == 0">
                    <field name="pos_order_count" widget="statinfo"
                           string="Register sales"/>
                </button>
                <!-- O RESULTADO ONDE O OLHO ESTÁ. A conta mora na aba de
                     Custos, mas "o evento deu dinheiro?" é a pergunta que se
                     faz ao abrir a ficha — e a aba fica abaixo de uma dobra
                     inteira de formulário. O dono procurou duas vezes e não
                     achou; isso é resposta. -->
                <button name="action_view_bills" type="object"
                        class="oe_stat_button" icon="fa-line-chart"
                        groups="liber_fairs.group_fair_manager"
                        invisible="not pos_order_count and not bill_ids">
                    <!-- SEM `string=`: o rótulo vem do próprio campo, que
                         já tem tradução. Escrito aqui, ele viraria um termo
                         de view com msgid repetido — e o .po recusa dois
                         msgid iguais, então a tradução simplesmente não
                         existiria e o botão diria "Result" em português. -->
                    <field name="result_total" widget="statinfo"/>
                </button>
            </div>
            <!-- Quem opera é cadastro do evento, como a grade: quem monta a
                 feira sabe quem vai estar no balcão. -->
            <page name="days" position="before">
                <page string="Registers" name="cashiers">
                    <field name="cashier_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="partner_id"/>
                            <field name="role"/>
                            <field name="access_state" widget="badge"
                                   readonly="1"
                                   decoration-warning="access_state == 'no_account'"
                                   decoration-success="access_state == 'granted'"/>
                            <field name="pos_config_id" readonly="1"/>
                        </list>
                    </field>
                    <div class="text-muted mt-2">
                        One register per operator. Access is given while the
                        event is on the road and taken back when the goods
                        come home; each person sees only the events they work
                        on. Somebody without an account works the counter but
                        does not open the system.
                    </div>
                </page>
                <!-- QUEM DECIDE QUANTO SE GANHA É QUEM PLANEJA. O gerente de
                     campo é circunstancial e não entra nesta conversa:
                     a aba inteira é de quem monta o evento. -->
                <page string="Commissions" name="commissions"
                      groups="liber_fairs.group_fair_manager">
                    <!-- Editável: o percentual, a diária e os dias se
                         digitam AQUI. O resto é conta, e conta não se
                         digita. E nada se digita antes do Planejar: é ele
                         que monta os dias e abre o analítico. -->
                    <div class="alert alert-info mb-2" role="status"
                         invisible="state != 'draft'">
                        Plan the event to agree on commissions: the days each
                        person works and the analytic account that carries
                        the cost are born there.
                    </div>
                    <field name="commission_line_ids"
                           readonly="state == 'draft'">
                        <list editable="bottom" create="false" delete="false">
                            <field name="partner_id"/>
                            <field name="role"/>
                            <field name="pos_amount" sum="Sold"/>
                            <field name="commission_pc"/>
                            <field name="commission_amount" sum="Commission"/>
                            <field name="daily_rate"/>
                            <field name="days"/>
                            <field name="daily_amount" sum="Dailies"/>
                            <field name="loss_share" sum="Loss share"/>
                            <field name="net_amount" sum="To pay"/>
                            <field name="uncovered_loss" sum="Still owed"
                                   optional="show"/>
                            <field name="bill_id" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="mt-2">
                        <group>
                            <field name="commission_total"/>
                            <field name="daily_total"/>
                        </group>
                        <group>
                            <field name="loss_total"/>
                            <field name="team_loss_total"/>
                            <field name="payout_total"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Commission is a percentage on what each person sold at
                        their own register. What vanished UNDER THEIR WATCH,
                        at cost, is split equally between them: the table is
                        everybody's, and nobody knows whose copy went missing.
                        What never arrived — the copy that left the warehouse
                        and did not reach the table — is not theirs and is not
                        split.
                        A bill is never negative — what the commission and the
                        dailies do not cover is written down, not charged.
                    </div>
                </page>
                <!-- O DINHEIRO QUE SAI, todo no mesmo lugar. As contas da
                     equipe caem aqui sozinhas no fechamento; o resto se
                     lança aqui, e o analítico do evento vai junto. Mesmo
                     dono das comissões: quem planeja. -->
                <page string="Costs" name="costs"
                      groups="liber_fairs.group_fair_manager">
                    <div class="mb-2">
                        <button name="action_add_cost" type="object"
                                string="Add a cost" class="btn-secondary"
                                help="A payable already pointed at this event: special freight, stand fee, the van, lodging."/>
                        <!-- PORTA DE REPESCAGEM, e só. As contas da equipe
                             nascem sozinhas no fechamento; quem preencher
                             comissão ou diária DEPOIS disso ficaria sem a
                             dele. O botão só aparece quando há alguém nessa
                             situação, e nunca duplica: quem já tem conta é
                             pulado. -->
                        <button name="action_generate_bills" type="object"
                                string="Create the missing bills"
                                class="btn-secondary ms-1"
                                invisible="state != 'returned' or bills_pending == 0"
                                help="Somebody had their numbers filled in after the event closed. This creates only the bills that are missing."/>
                        <field name="bills_pending" invisible="1"/>
                    </div>
                    <field name="bill_ids" readonly="1">
                        <list>
                            <field name="invoice_date"/>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="ref" optional="show"/>
                            <field name="amount_total" sum="Cost"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-success="state == 'posted'"/>
                            <field name="payment_state" widget="badge"
                                   optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="mt-2">
                        <group>
                            <field name="pos_amount_total"/>
                            <field name="cogs_total"/>
                        </group>
                        <group>
                            <field name="cost_total"/>
                            <field name="result_total"
                                   decoration-danger="result_total &lt; 0"
                                   decoration-bf="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The team's bills are born here when the event comes
                        home — one per person, in draft, because creating a
                        payable is not paying it. Everything else the event
                        spends goes in by hand, and carries the event's
                        analytic account with it.
                        The result takes what the register sold, subtracts
                        what those books cost the house, and subtracts these
                        costs. It is the difference between "the fair paid
                        for itself" and "the fair made money".
                    </div>
                </page>
            </page>
            <field name="stock_location_id" position="after">
                <field name="discount_pc"/>
                <field name="pos_amount_total" readonly="1"
                       invisible="pos_order_count == 0"/>
                <field name="company_currency_id" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
