#. module: liber_fairs_nfe
#. odoo-python
#: code:addons/liber_fairs_nfe/models/event_fair.py:0
msgid ""
"%(feira)s has not shipped yet: there is nothing to declare.\n"
"\n"
"Validate %(mov)s first — the note travels with the load, and a note declaring books that did not leave does not match the van."
msgstr ""

#. module: liber_fairs_nfe
#. odoo-python
#: code:addons/liber_fairs_nfe/models/event_fair.py:0
msgid "%s has no return travelling without a note."
msgstr "%s não tem retorno viajando sem nota."

#. module: liber_fairs_nfe
#. odoo-python
#: code:addons/liber_fairs_nfe/models/event_fair.py:0
msgid ""
"<p><b>%(feira)s — the return went out without a fiscal note.</b> The fair "
"return fiscal position of %(empresa)s is not configured (it needs Auto "
"Invoice Paid and its account, in Settings &gt; Fairs). Fix it and press "
"<b>Fiscal note</b>.</p>"
msgstr "<p><b>%(feira)s — o retorno saiu sem nota fiscal.</b> A posição fiscal de retorno de feira da %(empresa)s não está configurada (falta a baixa automática e a conta dela, em Definições &gt; Feiras). Ajuste e aperte <b>Nota fiscal</b>.</p>"

#. module: liber_fairs_nfe
#. odoo-python
#: code:addons/liber_fairs_nfe/models/event_fair.py:0
msgid ""
"<p><b>%(feira)s</b> — %(tipo)s <b>%(nota)s</b> issued for <b>%(mov)s</b>. It"
" lives in Invoicing &gt; Customers &gt; Remessas.</p>"
msgstr "<p><b>%(feira)s</b> — %(tipo)s <b>%(nota)s</b> emitida para <b>%(mov)s</b>. Ela fica em Faturamento &gt; Clientes &gt; Remessas.</p>"

