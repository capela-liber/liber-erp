msgid "Provider"
msgstr "Provedor"

#. module: liber_gdrive
#: model:ir.model.fields,field_description:liber_gdrive.field_liber_cloud_account__gdrive_refresh_token
msgid "Refresh Token"
msgstr "Refresh Token"

#. module: liber_gdrive
#: model:ir.ui.menu,name:liber_gdrive.menu_liber_gdrive_tags
msgid "Tags"
msgstr "Tags"

#. module: liber_gdrive
#. odoo-python
#: code:addons/liber_gdrive/services/gdrive_api.py:0
msgid ""
"The Google Drive account of %s is not configured. Fill in the client ID, "
"client secret and refresh token (see the module's NOTES.md for the one-time "
"setup)."
msgstr ""
"A conta Google Drive de %s não está configurada. Preencha o ID do cliente, "
"o segredo do cliente e o token de atualização (veja no NOTES.md do módulo "
"a configuração que se faz uma vez só)."

#. module: liber_gdrive
#. odoo-python
#: code:addons/liber_gdrive/services/gdrive_api.py:0
msgid ""
"This Google Workspace edition does not allow links with an expiration date. "
"Upgrade the plan, or set the period to 0 on the account to create links that"
" never expire."
msgstr ""
"Esta edição do Google Workspace não permite links com data de validade. "
"Suba o plano, ou ponha o período em 0 na conta para criar links que nunca "
"expiram."

#. module: liber_gdrive
#: model:ir.ui.menu,name:liber_gdrive.menu_liber_gdrive_upload
msgid "Upload"
msgstr "Enviar"

#. module: liber_gdrive
#: model:ir.model,name:liber_gdrive.model_liber_cloud_upload
