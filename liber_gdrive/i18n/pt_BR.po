#. module: liber_gdrive
#: model:ir.actions.act_window,name:liber_gdrive.action_liber_gdrive_upload
msgid "Upload to Drive"
msgstr "Enviar ao Drive"

#. module: liber_gdrive
#: model:res.groups,name:liber_gdrive.group_liber_gdrive_user
