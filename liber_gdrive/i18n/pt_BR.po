msgstr "Nenhum arquivo por aqui ainda"

#. module: liber_gdrive
#: model_terms:ir.actions.act_window,help:liber_gdrive.action_liber_gdrive_folder
msgid ""
"Paste the folder's Drive ID, name who reads and who writes,\n"
"                and press Sync."
msgstr ""
"Cole o ID da pasta no Drive, diga quem lê e quem escreve,\n"
"                e aperte Sincronizar."

#. module: liber_gdrive
#: model:ir.model.fields,field_description:liber_gdrive.field_liber_cloud_account__provider
