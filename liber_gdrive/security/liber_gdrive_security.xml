<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_liber_gdrive" model="res.groups.privilege">
        <!-- O cabeçalho da seção já diz "Cloud Files"; a linha diz o
             provedor. Ver o comentário no liber_cloud_files. -->
        <field name="name">Google Drive</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="liber_cloud_files.module_category_liber_cloud"/>
    </record>

    <record id="group_liber_gdrive_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_liber_gdrive"/>
        <field name="implied_ids"
               eval="[(4, ref('liber_cloud_files.group_liber_cloud_user'))]"/>
    </record>

    <record id="group_liber_gdrive_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_liber_gdrive"/>
        <field name="implied_ids"
               eval="[(4, ref('group_liber_gdrive_user')),
                      (4, ref('liber_cloud_files.group_liber_cloud_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_liber_gdrive_folder_manager" model="ir.rule">
        <field name="name">Drive managers see every Drive folder</field>
        <field name="model_id"
               ref="liber_cloud_files.model_liber_cloud_folder"/>
        <field name="domain_force">[('provider', '=', 'gdrive')]</field>
        <field name="groups" eval="[(4, ref('group_liber_gdrive_manager'))]"/>
        <!-- Read only, and deliberately: seeing every shelf of one's own
             provider is the manager's job; filling or emptying one is
             decided folder by folder, on its write ACL. Left unset, these
             perms default to TRUE and the manager silently edits and
             deletes records of folders they were never granted. -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_liber_gdrive_file_manager" model="ir.rule">
        <field name="name">Drive managers see every Drive file</field>
        <field name="model_id"
               ref="liber_cloud_files.model_liber_cloud_file"/>
        <field name="domain_force">[('provider', '=', 'gdrive')]</field>
        <field name="groups" eval="[(4, ref('group_liber_gdrive_manager'))]"/>
        <!-- Read only, and deliberately: seeing every shelf of one's own
             provider is the manager's job; filling or emptying one is
             decided folder by folder, on its write ACL. Left unset, these
             perms default to TRUE and the manager silently edits and
             deletes records of folders they were never granted. -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
