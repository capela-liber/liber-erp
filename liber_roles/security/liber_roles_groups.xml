<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_liber_roles" model="ir.module.category">
        <field name="name">Liber / Funções</field>
        <field name="description">Perfis por função da casa: um nível por departamento, mais a Direção. Os grupos do Odoo derivam daqui.</field>
        <field name="sequence">1</field>
    </record>

    <!-- v19: res.groups no longer carries category_id directly; it is held by a
         res.groups.privilege that the groups link to via privilege_id. One
         privilege per DEPARTMENT: the user form then offers the levels of each
         department as a single selection, and Direção (its own privilege)
         can be accumulated by a director who also runs a department. -->
    <record id="privilege_direcao" model="res.groups.privilege">
        <field name="name">Direção</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_category_liber_roles"/>
    </record>
    <record id="privilege_comercial" model="res.groups.privilege">
        <field name="name">Comercial</field>
        <field name="sequence">2</field>
        <field name="category_id" ref="module_category_liber_roles"/>
    </record>
    <record id="privilege_financeiro" model="res.groups.privilege">
        <field name="name">Financeiro</field>
        <field name="sequence">3</field>
        <field name="category_id" ref="module_category_liber_roles"/>
    </record>
    <record id="privilege_editorial" model="res.groups.privilege">
        <field name="name">Editorial</field>
        <field name="sequence">4</field>
        <field name="category_id" ref="module_category_liber_roles"/>
    </record>
    <record id="privilege_marketing" model="res.groups.privilege">
        <field name="name">Marketing</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="module_category_liber_roles"/>
    </record>
    <record id="privilege_visitante" model="res.groups.privilege">
        <field name="name">Visitante</field>
        <field name="sequence">6</field>
        <field name="category_id" ref="module_category_liber_roles"/>
    </record>

    <!-- ============================================================== -->
    <!-- Direção: leitura ampla + boards financeiros. Não operacional   -->
    <!-- (na v1 a edição ainda não é bloqueada; fase 2). Diretor que    -->
    <!-- opera uma área acumula também o nível daquela área.            -->
    <!-- ============================================================== -->
    <record id="group_direcao" model="res.groups">
        <field name="name">Diretor(a)</field>
        <field name="privilege_id" ref="privilege_direcao"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('account.group_account_readonly')),
            (4, ref('liber_budget.group_budget_user')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('liber_soc_agreements.group_soc_user')),
            (4, ref('liber_copyright_contracts.group_contract_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('project.group_project_user')),
        ]"/>
        <field name="comment">Sócios e diretores: relatórios contábeis (leitura), boards do orçamento, visão de vendas, consignação, contratos, estoque e projetos.</field>
    </record>

    <!-- ============================================================== -->
    <!-- Comercial                                                      -->
    <!-- ============================================================== -->
    <record id="group_comercial_assistente" model="res.groups">
        <field name="name">Assistente</field>
        <field name="privilege_id" ref="privilege_comercial"/>
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('liber_soc_agreements.group_soc_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('base.group_partner_manager')),
        ]"/>
        <field name="comment">Opera o dia a dia comercial: pedidos, acertos de consignação, devoluções, clientes. Vê todos os documentos de venda (v1). Sem relatórios financeiros.</field>
    </record>

    <record id="group_comercial_gerente" model="res.groups">
        <field name="name">Gerente</field>
        <field name="privilege_id" ref="privilege_comercial"/>
        <field name="implied_ids" eval="[
            (4, ref('group_comercial_assistente')),
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('liber_soc_agreements.group_soc_manager')),
        ]"/>
        <field name="comment">Tudo do assistente + administra vendas e consignação: fecha contratos AC, cria campanhas, ajusta réguas de cobrança de devolução, relatórios do canal.</field>
    </record>

    <!-- ============================================================== -->
    <!-- Financeiro. A regra de ouro dos boards mora aqui: o painel do  -->
    <!-- orçamento exige os grupos do `budget` e os relatórios          -->
    <!-- contábeis exigem account_readonly+, e só Gerente (e Direção)   -->
    <!-- os recebem. O Assistente é Cobrança: fatura e paga, não lê     -->
    <!-- consolidado.                                                   -->
    <!-- ============================================================== -->
    <record id="group_financeiro_assistente" model="res.groups">
        <field name="name">Assistente</field>
        <field name="privilege_id" ref="privilege_financeiro"/>
        <field name="implied_ids" eval="[
            (4, ref('account.group_account_invoice')),
            (4, ref('base.group_partner_manager')),
        ]"/>
        <field name="comment">Cobrança: cria faturas, registra e prepara pagamentos, concilia. Sem relatórios contábeis, sem orçamento, sem boards.</field>
    </record>

    <record id="group_financeiro_gerente" model="res.groups">
        <field name="name">Gerente</field>
        <field name="privilege_id" ref="privilege_financeiro"/>
        <field name="implied_ids" eval="[
            (4, ref('group_financeiro_assistente')),
            (4, ref('account.group_account_manager')),
            (4, ref('liber_budget.group_budget_manager')),
        ]"/>
        <field name="comment">Contabilidade completa: valida e estorna, configura plano de contas e impostos, administra o orçamento, vê os boards financeiros. Pagamentos de royalties.</field>
    </record>

    <!-- ============================================================== -->
    <!-- Editorial. Autores são parceiros (partner_manager); o catálogo -->
    <!-- (produtos/Metabooks) chega via stock_user.                     -->
    <!-- ============================================================== -->
    <record id="group_editorial_assistente" model="res.groups">
        <field name="name">Assistente</field>
        <field name="privilege_id" ref="privilege_editorial"/>
        <field name="implied_ids" eval="[
            (4, ref('liber_copyright_contracts.group_contract_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('base.group_partner_manager')),
        ]"/>
        <field name="comment">Opera contratos de direitos autorais e edita fichas do catálogo. Consulta os cálculos de royalty; não fecha períodos.</field>
    </record>

    <record id="group_editorial_gerente" model="res.groups">
        <field name="name">Gerente</field>
        <field name="privilege_id" ref="privilege_editorial"/>
        <field name="implied_ids" eval="[
            (4, ref('group_editorial_assistente')),
            (4, ref('liber_copyright_contracts.group_contract_manager')),
        ]"/>
        <field name="comment">Editor: administra contratos de direitos, fecha períodos de royalty, arquiva títulos. Vê valores a pagar dos contratos (pagar é do Financeiro).</field>
    </record>

    <!-- ============================================================== -->
    <!-- Marketing: conteúdo do site. Vê campanhas de consignação (via  -->
    <!-- soc_user no Gerente); criá-las é do Comercial. mass_mailing    -->
    <!-- não está instalado; quando entrar, os grupos entram aqui.      -->
    <!-- ============================================================== -->
    <record id="group_marketing_assistente" model="res.groups">
        <field name="name">Assistente</field>
        <field name="privilege_id" ref="privilege_marketing"/>
        <field name="implied_ids" eval="[
            (4, ref('website.group_website_restricted_editor')),
        ]"/>
        <field name="comment">Edita conteúdo do site. Sem dados financeiros.</field>
    </record>

    <record id="group_marketing_gerente" model="res.groups">
        <field name="name">Gerente</field>
        <field name="privilege_id" ref="privilege_marketing"/>
        <field name="implied_ids" eval="[
            (4, ref('group_marketing_assistente')),
            (4, ref('website.group_website_designer')),
            (4, ref('liber_soc_agreements.group_soc_user')),
        ]"/>
        <field name="comment">Publica e configura o site; acompanha campanhas de consignação (criar é do Comercial). Sem dados financeiros.</field>
    </record>

    <!-- ============================================================== -->
    <!-- Visitante: a conta da apresentação pública. Vê OS APPS DO      -->
    <!-- LIBER em nível usuário, não grava nada.                        -->
    <!--                                                                -->
    <!-- A v1 era generosa (gerente em tudo): demonstrava o Odoo        -->
    <!-- inteiro, não o produto. A v2 (20/07/2026) apertou para         -->
    <!-- Consignação, Direitos autorais, Bonificação e Catálogo.        -->
    <!--                                                                -->
    <!-- A régua da v3 (27/07/2026) é outra, e é mais fácil de manter   -->
    <!-- honesta: **a demo abre o que a demo promete**. Duas partes:    -->
    <!--                                                                -->
    <!-- 1. Toda tela com manual publicado em liber_site. O corte da    -->
    <!--    v2 era por app, e por isso escondia telas que os manuais    -->
    <!--    descreviam em detalhe — quem lia "Cálculo de royalties" e   -->
    <!--    entrava na demo não achava a tela. Manual que promete o     -->
    <!--    que a demo não mostra é pior que demo pequena.              -->
    <!--                                                                -->
    <!-- 2. Vendas e eCommerce. Não têm manual próprio por serem do     -->
    <!--    Odoo cru, mas são a vitrine: quem abre a demonstração de    -->
    <!--    um ERP de editora espera ver o pedido e a loja. Ficaram de  -->
    <!--    fora da primeira rodada da v3 justamente porque a régua     -->
    <!--    era só o manual — e a ausência apareceu na hora.            -->
    <!--                                                                -->
    <!-- O que isso trouxe para dentro, e por quê:                      -->
    <!-- - contract_manager: os manuais de Cálculo de royalties, IRRF   -->
    <!--   e Pagamento de royalties. As três telas são gated em         -->
    <!--   manager, não em user — daí precisar do grupo "de gerente"    -->
    <!--   para uma conta que não grava nada.                           -->
    <!-- - account_readonly: os manuais de Importação de XML de NF-e e  -->
    <!--   de Notas de remessa. Ambos os menus penduram em              -->
    <!--   account.menu_finance.                                        -->
    <!-- - budget_user: o manual de Orçamento.                          -->
    <!-- - sale_salesman_all_leads: Vendas E eCommerce de uma vez —     -->
    <!--   sale.sale_menu_root é livre, mas os filhos que importam      -->
    <!--   (Pedidos, Cotações, Faturamento, Catálogo) e o               -->
    <!--   website_sale.menu_ecommerce exigem group_sale_salesman.      -->
    <!--   A variante _all_leads é deliberada: com o salesman simples   -->
    <!--   a regra de registro filtra os pedidos pelo vendedor dono, o  -->
    <!--   visitante não é dono de nenhum, e a tela abriria VAZIA.      -->
    <!--   Demo vazia é pior que tela fechada. O group_sale_manager     -->
    <!--   segue fora: ele traz configuração e relatórios gerenciais,   -->
    <!--   que não são vitrine.                                         -->
    <!--                                                                -->
    <!-- O preço, dito em voz alta: esta conta é pública e circula, e   -->
    <!-- agora ela lê Faturamento e Orçamento. São números da casa. A   -->
    <!-- troca foi consciente — a demo existe para mostrar o produto —  -->
    <!-- mas se um dia a base deixar de ser de demonstração e passar a  -->
    <!-- ter movimento real, esta é a primeira linha a revisar.         -->
    <!--                                                                -->
    <!-- Fora do menu de propósito, mesmo tendo manual:                 -->
    <!-- - liber_roles ("Papéis de acesso"): a tela é a administração   -->
    <!--   de acesso. Manual documenta a ideia; a demo não precisa      -->
    <!--   entregar o painel. Exigiria base.group_system.               -->
    <!-- - Dropbox, Drive e GitHub: os módulos não estão instalados     -->
    <!--   nesta base. Quando entrarem, os grupos deles entram aqui.    -->
    <!--                                                                -->
    <!-- Duas ausências que continuam deliberadas:                      -->
    <!-- - a trava de escrita segue em models/ir_model_access.py: o     -->
    <!--   nível dos grupos daqui é visibilidade, nunca poder.          -->
    <!-- - base.group_allow_export: a conta é pública e circula. Sem     -->
    <!--   escrita ela ainda poderia levar a base embora em .xlsx —      -->
    <!--   e com Faturamento agora visível, isso pesa mais, não menos.   -->
    <!-- ============================================================== -->
    <record id="group_visitante" model="res.groups">
        <field name="name">Visitante (demonstração)</field>
        <field name="privilege_id" ref="privilege_visitante"/>
        <!-- A ORDEM DESTA LISTA É SIGNIFICATIVA, e custou um susto.
             Ela é uma sequência de comandos, executada de cima para baixo:
             conceder um grupo dispara a cascata dos módulos que reagem a
             ele, e essa cascata pode trazer grupos de volta. Quando os
             (3, ...) vinham primeiro, conceder sale_salesman_all_leads no
             fim re-introduziu project.group_project_user (via sale_project)
             e website.group_website_restricted_editor (via website_sale) na
             conta pública — dois apps que a régua manda esconder, sem
             ninguém pedir e sem erro nenhum aparecer.
             Concessões primeiro, remoções por último: assim a limpeza é a
             última palavra, aconteça o que acontecer no meio. -->
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('liber_soc_agreements.group_soc_user')),
            (4, ref('liber_copyright_contracts.group_contract_user')),
            (4, ref('liber_copyright_contracts.group_contract_manager')),
            (4, ref('liber_metabooks_integration.metabooks_product_group')),
            (4, ref('liber_metabooks_integration.metadata_group')),
            (4, ref('liber_budget.group_budget_user')),
            (4, ref('account.group_account_readonly')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (3, ref('sales_team.group_sale_manager')),
            (3, ref('stock.group_stock_manager')),
            (3, ref('project.group_project_user')),
            (3, ref('website.group_website_restricted_editor')),
            (3, ref('liber_soc_agreements.group_soc_manager')),
            (3, ref('liber_budget.group_budget_manager')),
        ]"/>
        <!-- Módulo de fora que queira somar (ou tirar) grupos do visitante faz
             isso por conta própria, com comandos (4, ...) / (3, ...): eles são
             incrementais e sobrevivem a um -u liber_roles. É assim que um módulo
             que não vive neste repositório entra na conta pública sem que este
             precise conhecê-lo, e sem que a lista acima cresça a cada
             integração. Para tirar da conta um grupo que já esteja na ficha do
             usuário, ver o `extras` em models/res_users.py. -->
        <field name="comment">Conta de demonstração pública: abre em leitura toda tela que tem manual publicado — consignação, direitos autorais e seus royalties, fiscal, catálogo e orçamento — mais Vendas e eCommerce, que são a vitrine. Escreve só no chatter; a trava de escrita é no ORM, não no menu.</field>
    </record>

    <!-- A última palavra sobre o visitante, e ela precisa ser em Python.
         As entradas (3, ...) acima desfazem o VÍNCULO entre dois grupos; não
         alcançam grupo que o usuário carrega direto. E é assim que a carona
         chega: conceder o grupo de vendas fez o sale_project acrescentar
         project.group_project_user e o website_sale acrescentar
         website.group_website_restricted_editor direto na conta pública.
         Esta chamada roda em todo -u liber_roles e devolve a conta ao
         recorte declarado. Vem por último de propósito: depois dos grupos,
         depois da cascata. -->
    <function model="res.users" name="_liber_faxina_do_visitante"/>

</odoo>
