<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Consulta é para todo mundo que opera: perguntar não move nada, e o ORM
        já barra o que a pessoa não poderia ler com as próprias mãos. Propor
        orçamento é só do comercial, porque é lá que S000 é assunto.
    -->

    <!-- ============ Direção: lê largo, não opera ============ -->
    <record id="liber_roles.group_direcao" model="res.groups">
        <field name="capela_ai_max_records">50</field>
        <field name="capela_ai_tool_ids" eval="[
            (4, ref('capela_ai.tool_query_search')),
            (4, ref('capela_ai.tool_query_group_by')),
        ]"/>
    </record>

