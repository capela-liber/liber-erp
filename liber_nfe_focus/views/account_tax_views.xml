<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- O CFOP no imposto: é por aqui que a posição fiscal o entrega à nota. -->
    <record id="view_tax_form_focus" model="ir.ui.view">
        <field name="name">account.tax.form.focus.nfe</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="type_tax_use" position="after">
                <field name="nfe_operacao_id"/>
            </field>
        </field>
    </record>

    <record id="view_tax_list_focus" model="ir.ui.view">
        <field name="name">account.tax.list.focus.nfe</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_tree"/>
        <field name="arch" type="xml">
            <field name="type_tax_use" position="after">
                <field name="nfe_operacao_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
