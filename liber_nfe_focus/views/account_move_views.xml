<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A nota fiscal na fatura: um cabeçalho com os três verbos (emitir,
         consultar, cancelar) e uma aba com o que a SEFAZ respondeu. -->
    <record id="view_move_form_focus" model="ir.ui.view">
        <field name="name">account.move.form.focus.nfe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="focus_status" invisible="1"/>
                <field name="focus_ref" invisible="1"/>
                <button name="action_focus_emitir" type="object"
                        string="Emitir NFe" class="btn-primary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or focus_status in ('processando_autorizacao', 'autorizado', 'cancelado')"/>
                <button name="action_focus_consultar" type="object"
                        string="Consultar SEFAZ"
                        invisible="not focus_ref or focus_status in ('cancelado',)"/>
                <button name="action_focus_carta_correcao" type="object"
                        string="Carta de Correção"
                        invisible="focus_status != 'autorizado'"/>
                <button name="action_focus_cancelar" type="object"
                        string="Cancelar NFe"
                        invisible="focus_status != 'autorizado'"/>
            </header>

            <!-- O status vira faixa: quem abre a fatura vê na hora se a nota
                 existe na SEFAZ, sem procurar aba. -->
            <div name="button_box" position="before">
                <widget name="web_ribbon" title="NFe autorizada"
                        bg_color="text-bg-success"
                        invisible="focus_status != 'autorizado'"/>
                <widget name="web_ribbon" title="NFe rejeitada"
                        bg_color="text-bg-danger"
                        invisible="focus_status != 'erro_autorizacao'"/>
            </div>

            <notebook position="inside">
                <page string="NFe (Focus)" name="focus_nfe"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="SEFAZ">
                            <field name="focus_status" readonly="1"/>
                            <field name="nfe_key" readonly="1"/>
                            <field name="focus_numero" readonly="1"/>
                            <field name="focus_serie" readonly="1"/>
                            <field name="focus_protocolo" readonly="1"/>
                        </group>
                        <group string="Operação fiscal">
                            <field name="nfe_cfop_id"
                                   readonly="focus_status in ('autorizado', 'processando_autorizacao', 'cancelado')"/>
                            <field name="focus_nota_referenciada_id"
                                   domain="[('nfe_key', '!=', False), ('id', '!=', id)]"
                                   readonly="focus_status in ('autorizado', 'processando_autorizacao', 'cancelado')"/>
                            <field name="focus_chave_referenciada"
                                   readonly="focus_status in ('autorizado', 'processando_autorizacao', 'cancelado')"/>
                            <field name="focus_ref" readonly="1"/>
                            <field name="focus_ambiente" readonly="1"/>
                        </group>
                    </group>
                    <field name="focus_mensagem" readonly="1"
                           invisible="not focus_mensagem"/>
                    <group string="Cartas de correção" invisible="not focus_correcoes">
                        <field name="focus_correcoes" nolabel="1" readonly="1"/>
                    </group>
                </page>
            </notebook>

            <!-- O CFOP é por linha porque uma nota pode misturar operações
                 (venda e bonificação na mesma remessa). Vazio herda o padrão
                 da empresa. -->
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='quantity']"
                   position="before">
                <field name="nfe_cfop_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_list_focus" model="ir.ui.view">
        <field name="name">account.move.list.focus.nfe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <!-- Ao lado do status de pagamento: `state` não existe como coluna
                 nesta lista, o status visível é o `status_in_payment`. -->
            <field name="status_in_payment" position="after">
                <field name="focus_status" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_focus" model="ir.ui.view">
        <field name="name">account.move.search.focus.nfe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="draft" position="after">
                <separator/>
                <filter name="focus_pendente" string="NFe processando"
                        domain="[('focus_status', '=', 'processando_autorizacao')]"/>
                <filter name="focus_erro" string="NFe rejeitada"
                        domain="[('focus_status', '=', 'erro_autorizacao')]"/>
                <filter name="focus_autorizada" string="NFe autorizada"
                        domain="[('focus_status', '=', 'autorizado')]"/>
            </filter>
        </field>
    </record>
</odoo>
