<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_focus" model="ir.ui.view">
        <field name="name">product.template.form.focus.nfe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[@name='group_general']"
                   position="inside">
                <field name="nfe_ncm"/>
                <field name="nfe_origem"/>
                <field name="nfe_codigo_beneficio_fiscal"/>
                <field name="nfe_ibs_cbs_cst"/>
                <field name="nfe_ibs_cbs_classificacao"/>
            </xpath>
        </field>
    </record>
</odoo>
