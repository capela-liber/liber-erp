<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One document per beneficiary, rendered in the BENEFICIARY'S language
         (t-lang): the labels are English in the source and Portuguese through
         the translation file, so a Brazilian author reads "Prestação de
         contas" and a foreign publisher reads "Royalty statement" from the
         same template. Amounts follow the beneficiary's currency when a rate
         exists (see res_partner_statement.py). -->
    <template id="report_royalty_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="st" t-value="statements[doc.id]"/>
                <t t-call="liber_copyright_contracts_reports.report_royalty_statement_document"
                   t-lang="st['lang']"/>
            </t>
        </t>
    </template>

    <template id="report_royalty_statement_document">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Table styling: gradient header + soft striped
                             rows, in the palette derived from the company's
                             document-layout color (``colors``, see the report
                             parser). Each background has a solid fallback
                             first, because wkhtmltopdf's WebKit may skip the
                             gradient. -->
                        <style>
                            /* Do not trust Bootstrap here: the class is in the
                               HTML but wkhtmltopdf's WebKit does not resolve it,
                               so every money column rendered left-aligned. State
                               the rule the document itself depends on. */
                            .text-end { text-align: right; }
                            .royalty-table th {
                                color: <t t-out="colors['header_text']"/>;
                                background: <t t-out="colors['header']"/>;
                                background: linear-gradient(90deg, <t t-out="colors['header_dark']"/> 0%, <t t-out="colors['header']"/> 45%, <t t-out="colors['header_light']"/> 100%);
                                border: none;
                            }
                            .royalty-table tbody tr:nth-child(even) td {
                                background: <t t-out="colors['row']"/>;
                                background: linear-gradient(90deg, <t t-out="colors['row']"/> 0%, <t t-out="colors['row_light']"/> 100%);
                            }
                        </style>

                        <t t-set="hdr" t-value="st['header']"/>
                        <!-- Envelope window: the address block sits where the
                             window of the envelope falls once the sheet is
                             folded in three (Settings > Copyright > Envelope);
                             the reserved height keeps the rest below it. -->
                        <div t-if="not st.get('no_window')" t-attf-style="position: relative; height: #{hdr['window']['top'] + hdr['window']['height'] + 4}mm;">
                            <div class="edlab-window" t-attf-style="position: absolute; top: #{hdr['window']['top']}mm; left: #{hdr['window']['left']}mm; width: #{hdr['window']['width']}mm; height: #{hdr['window']['height']}mm; padding: 1.5mm 3mm; font-size: 10.5pt; line-height: 1.25; overflow: hidden;">
                                <t t-foreach="hdr['address_lines']" t-as="line">
                                    <span t-esc="line"/><br/>
                                </t>
                            </div>
                        </div>

                        <!-- Title + works (bullets, no contact name: the
                             beneficiary may not be the author). -->
                        <div style="margin-top: 8px;">
                            <h2 style="margin-bottom: 4px;">Royalty statement</h2>
                            <t t-if="st['works']">
                                <ul style="margin-top: 8px;">
                                    <li t-foreach="st['works']" t-as="w">
                                        <em t-esc="w"/>
                                    </li>
                                </ul>
                            </t>
                        </div>

                        <!-- Beneficiary and payment, at the top: what the
                             department checks before the envelope is sealed. -->
                        <div style="margin-top: 16px;">
                            <div style="font-variant: small-caps; color: #555; border-bottom: 1px solid #ccc; padding-bottom: 2px; margin-bottom: 8px;">beneficiary</div>
                            <table style="width: 100%; font-size: 0.95em;">
                                <tr>
                                    <td style="vertical-align: top; width: 58%; padding-right: 12px;">
                                        <t t-foreach="hdr['identification']" t-as="row">
                                            <strong t-esc="row[0]"/> <span t-esc="row[1]"/><br/>
                                        </t>
                                    </td>
                                    <td style="vertical-align: top;">
                                        <t t-if="hdr['payment']">
                                            <t t-foreach="hdr['payment']" t-as="row">
                                                <strong t-esc="row[0]"/> <span t-esc="row[1]"/><br/>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <em>No bank details on file.</em>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Summary -->
                        <div style="margin-top: 24px;">
                            <div style="font-variant: small-caps; color: #555; border-bottom: 1px solid #ccc; padding-bottom: 2px; margin-bottom: 8px;">summary</div>
                            <table class="table table-sm" style="width: auto;">
                                <tr>
                                    <td><strong>Period</strong></td>
                                    <td><span t-esc="st['period_label']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Total amount</strong></td>
                                    <td class="text-end"><span t-esc="st['accrued']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/></td>
                                </tr>
                                <!-- Only shown when there is something to recover:
                                     the author has to see why the payable amount
                                     is smaller than what the works earned. -->
                                <tr t-if="st['advance_recouped']">
                                    <td><strong>To recover (advance)</strong></td>
                                    <td class="text-end"><span t-esc="-st['advance_recouped']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/></td>
                                </tr>
                                <tr>
                                    <td><strong>To deduct (IRRF)</strong></td>
                                    <td class="text-end"><span t-esc="-st['irrf']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/></td>
                                </tr>
                                <tr style="border-top: 2px solid #000;">
                                    <td><strong>Payable</strong></td>
                                    <td class="text-end"><strong><span t-esc="st['net']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/></strong></td>
                                </tr>
                            </table>
                        </div>

                        <!-- Royalties earned -->
                        <div style="margin-top: 24px;">
                            <div style="font-variant: small-caps; color: #555; border-bottom: 1px solid #ccc; padding-bottom: 2px; margin-bottom: 8px;">royalties</div>
                            <t t-if="st['rows']">
                                <table class="table table-sm o_main_table royalty-table">
                                    <thead>
                                        <tr>
                                            <th>Work / Channel</th>
                                            <th>Contract</th>
                                            <th class="text-end">Copies sold</th>
                                            <th class="text-end">Base amount</th>
                                            <th class="text-end">%</th>
                                            <th class="text-end">Royalty</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="st['rows']" t-as="row">
                                            <td><span t-esc="row['work']"/></td>
                                            <td><span t-esc="row['contract']"/></td>
                                            <td class="text-end"><span t-esc="row['qty']"/></td>
                                            <td class="text-end">
                                                <span t-esc="row['base']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                            <td class="text-end"><span t-esc="row['percentage_label']"/></td>
                                            <td class="text-end">
                                                <span t-esc="row['amount']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr style="font-weight: bold; border-top: 2px solid #000;">
                                            <td colspan="5" class="text-end">Total</td>
                                            <td class="text-end">
                                                <span t-esc="st['accrued']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </t>
                            <t t-else="">
                                <p><em>No royalties outstanding.</em></p>
                            </t>
                        </div>

                        <!-- Advances already paid to the beneficiary -->
                        <t t-if="st['advances']">
                            <div style="margin-top: 24px;">
                                <div style="font-variant: small-caps; color: #555; border-bottom: 1px solid #ccc; padding-bottom: 2px; margin-bottom: 8px;">advances</div>
                                <table class="table table-sm o_main_table">
                                    <thead>
                                        <tr>
                                            <th>Work / Channel</th>
                                            <th>Contract</th>
                                            <th class="text-end">Recoupable advance</th>
                                            <th class="text-end">Non-recoupable</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="st['advances']" t-as="adv">
                                            <td><span t-esc="adv['work']"/></td>
                                            <td><span t-esc="adv['contract']"/></td>
                                            <td class="text-end">
                                                <span t-esc="adv['recoupable']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="adv['non_recoupable']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr style="font-weight: bold; border-top: 2px solid #000;">
                                            <td colspan="2" class="text-end">Total</td>
                                            <td class="text-end">
                                                <span t-esc="st['recoupable_advance_total']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="st['non_recoupable_advance_total']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                                <p style="color: #555; font-size: 0.9em;"><em>The recoupable advance was already paid to the author and is recovered as royalties accrue.</em></p>
                            </div>
                        </t>

                        <!-- Special sales detail -->
                        <t t-if="st['special_sales']">
                            <div style="margin-top: 24px;">
                                <div style="font-variant: small-caps; color: #555; border-bottom: 1px solid #ccc; padding-bottom: 2px; margin-bottom: 8px;">special sales</div>
                                <table class="table table-sm o_main_table royalty-table">
                                    <thead>
                                        <tr>
                                            <th>Customer</th>
                                            <th>Document</th>
                                            <th>Work</th>
                                            <th class="text-end">Quantity</th>
                                            <th class="text-end">Discount</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="st['special_sales']" t-as="sale">
                                            <td><span t-esc="sale['customer']"/></td>
                                            <td><span t-esc="sale['invoice']"/></td>
                                            <td><span t-esc="sale['work']"/></td>
                                            <td class="text-end"><span t-esc="sale['qty']"/></td>
                                            <td class="text-end"><span t-esc="sale['discount_label']"/></td>
                                            <td class="text-end">
                                                <span t-esc="sale['amount']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr style="font-weight: bold; border-top: 2px solid #000;">
                                            <td colspan="5" class="text-end">Total</td>
                                            <td class="text-end">
                                                <span t-esc="st['special_sales_total']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </t>

                        <!-- Open payment bill(s): the statement total matches
                             the amount still owed on them. -->
                        <t t-if="st['bills']">
                            <div style="margin-top: 24px;">
                                <div style="font-variant: small-caps; color: #555; border-bottom: 1px solid #ccc; padding-bottom: 2px; margin-bottom: 8px;">payment order</div>
                                <table class="table table-sm o_main_table royalty-table">
                                    <thead>
                                        <tr>
                                            <th>Document</th>
                                            <th>Date</th>
                                            <th>Payment</th>
                                            <th>Status</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Outstanding</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="st['bills']" t-as="bill">
                                            <td><span t-esc="bill['name']"/></td>
                                            <td><span t-esc="bill['date_label']"/></td>
                                            <td><span t-esc="bill['due_label']"/></td>
                                            <td><span t-esc="bill['state_label']"/></td>
                                            <td class="text-end">
                                                <span t-esc="bill['amount_total']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="bill['amount_residual']" t-options='{"widget": "monetary", "display_currency": st["currency"]}'/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>

                        <t t-if="st.get('fx_note')">
                            <p style="color: #555; font-size: 0.9em; margin-top: 16px;"><em t-esc="st['fx_note']"/></p>
                        </t>
                        <div class="text-end" style="margin-top: 32px;">
                            <span t-esc="st['today_label']"/>
                        </div>

                    </div>
                </t>
    </template>


    <!-- Envelope proof: frame of the window with the address, and the two
         fold lines. Fold on the lines, top panel outward, and check the
         address shows through the window; adjust the millimetres in
         Settings > Copyright > Envelope until it does. -->
    <template id="report_envelope_proof">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="hdr" t-value="doc.with_context(lang=doc.lang or doc.env.lang)._edlab_statement_header()"/>
                <t t-call="web.external_layout">
                    <div class="page" style="position: relative;">
                        <div t-attf-style="position: absolute; top: #{hdr['window']['top']}mm; left: #{hdr['window']['left']}mm; width: #{hdr['window']['width']}mm; height: #{hdr['window']['height']}mm; border: 1px dashed #999; padding: 1.5mm 3mm; font-size: 10.5pt; line-height: 1.25; overflow: hidden;">
                            <t t-foreach="hdr['address_lines']" t-as="line">
                                <span t-esc="line"/><br/>
                            </t>
                        </div>
                        <t t-foreach="hdr['window']['folds']" t-as="fold">
                            <div t-attf-style="position: absolute; top: #{fold}mm; left: 0; right: 0; border-top: 1px dotted #999;">
                                <span style="font-size: 8pt; color: #999; position: absolute; right: 4mm; top: -4mm;">fold</span>
                            </div>
                        </t>
                        <div t-attf-style="position: absolute; top: #{hdr['window']['folds'][0] + 6}mm; left: 0; font-size: 9pt; color: #555;">
                            <t t-esc="hdr['caption']"/>
                        </div>
                        <div style="height: 240mm;"></div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
