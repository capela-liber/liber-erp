<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The statement's own paper format: same sheet and side margins as
         the house's A4, with a top margin the company sets in Settings
         (letterhead height) so the address block can reach the envelope
         window. Kept noupdate: the company's value must survive updates. -->
    <record id="paperformat_royalty_statement" model="report.paperformat">
        <field name="name">Royalty statement (window envelope)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">52</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_spacing">50</field>
        <field name="dpi">90</field>
    </record>
</odoo>
