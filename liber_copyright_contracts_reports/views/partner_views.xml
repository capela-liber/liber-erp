<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Two tabs on the contact (14/10/2026): "Beneficiary" holds the person
         (identification, sensitive personal data, payment, regional)
         and the base "Copyright Contracts" tab keeps the contracts, the
         royalty lines and the royalty figures. The royalties department
         asked for the personal data on a tab of its own, because it is what
         they check before a statement goes to the post. -->
    <record id="view_partner_form_edlab_author" model="ir.ui.view">
        <field name="name">res.partner.form.edlab.beneficiary</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="liber_copyright_contracts.view_partner_form_copyright_contracts"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='copyright_contracts']" position="before">
                <page string="Beneficiary" name="edlab_beneficiary"
                      groups="liber_copyright_contracts.group_contract_user"
                      invisible="not is_edlab_author and edlab_contract_count == 0">
                    <field name="is_edlab_author" invisible="1"/>
                    <group>
                        <!-- Natural person -->
                        <group string="Identification" name="edlab_identification_person"
                               invisible="is_company">
                            <field name="vat" string="CPF" readonly="1"/>
                            <field name="edlab_rg"/>
                            <field name="edlab_pis"/>
                            <field name="edlab_birthdate"/>
                            <field name="edlab_birth_place"/>
                            <field name="edlab_nationality"/>
                        </group>
                        <!-- Company -->
                        <!-- Company: the legal name is the form header and the
                             head office ("sede") is the Address group below,
                             both read-only repeats; what is typed here is the
                             trade name, the municipal registration and the
                             collaborator who handles the contract. -->
                        <group string="Identification" name="edlab_identification_company"
                               invisible="not is_company">
                            <field name="edlab_trade_name"/>
                            <field name="vat" string="CNPJ" readonly="1"/>
                            <field name="edlab_municipal_registration"/>
                            <field name="edlab_legal_representative_id"/>
                        </group>
                        <group string="Personal Data" name="edlab_personal_data"
                               invisible="is_company"
                               groups="liber_copyright_contracts.group_contract_manager">
                            <field name="edlab_marital_status"/>
                            <field name="edlab_education"/>
                            <field name="edlab_race"/>
                        </group>
                    </group>
                    <group>
                        <!-- CPF/CNPJ, language and address are edited in the
                             contact header; here they are read-only repeats,
                             so the tab shows what the post and the statement
                             will use without a second place to type it. -->
                        <group string="Regional" name="edlab_regional">
                            <field name="lang" readonly="1"/>
                            <field name="edlab_beneficiary_currency_id"/>
                        </group>
                        <group string="Address" name="edlab_address">
                            <field name="street" readonly="1"/>
                            <field name="street2" readonly="1"/>
                            <field name="city" readonly="1"/>
                            <field name="state_id" readonly="1"/>
                            <field name="zip" readonly="1"/>
                            <field name="country_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Payment"/>
                    <field name="bank_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="bank_id"/>
                            <field name="edlab_agency"/>
                            <field name="acc_number"/>
                            <field name="edlab_account_kind"/>
                            <field name="edlab_pix_key_type"/>
                            <field name="edlab_pix_key"/>
                            <field name="edlab_prefer_pix"/>
                            <field name="acc_holder_name" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <xpath expr="//page[@name='copyright_contracts']/field[@name='edlab_contract_ids']"
                   position="before">
                <group>
                    <group string="Royalties">
                        <field name="edlab_irrf_percentage"/>
                        <field name="edlab_currency_id" invisible="1"/>
                        <field name="edlab_royalty_balance"/>
                        <field name="edlab_last_statement_date"/>
                    </group>
                </group>
                <separator string="Royalty Lines"/>
                <field name="edlab_royalty_line_ids" readonly="1">
                    <list>
                        <field name="contract_id"/>
                        <field name="product_id"/>
                        <field name="last_payment_date"/>
                        <field name="edlab_currency_id" invisible="1"/>
                        <field name="edlab_open_balance"/>
                    </list>
                </field>
                <separator string="Contracts"/>
            </xpath>

        </field>
    </record>

    <!-- Statement in the Action menu (replaces the in-form button):
         opens the period wizard -> print PDF or email via template. -->
    <record id="action_server_royalty_statement" model="ir.actions.server">
        <field name="name">Royalty Statement</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('liber_copyright_contracts.group_contract_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_open_royalty_statement_wizard()</field>
    </record>

</odoo>
