msgid ""
"Use these keywords in the title to set new tasks:\n"
"\n"
"            #tags Set tags on the task\n"
"            @user Assign the task to a user\n"
"            ! Set the task a medium priority\n"
"            !! Set the task a high priority\n"
"            !!! Set the task a urgent priority\n"
"\n"
"            Make sure to use the right format and order e.g. Improve the configuration screen #feature #v16 @Mitchell !"
msgstr ""

#. module: liber_project_stage_jobs
#: model_terms:ir.ui.view,arch_db:liber_project_stage_jobs.task_type_edit_jobs
msgid ""
"When a task enters this column, each job below is scheduled as an activity of the\n"
"                            task, due at the start of production plus its days. Production starts the production\n"
"                            period before the task's deadline."
msgstr "Quando uma tarefa entra nesta coluna, cada job abaixo é agendado como atividade dela, com vencimento no início da produção mais os seus dias. A produção começa o período de produção antes do Prazo final da tarefa."

