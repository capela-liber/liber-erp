<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Um plano é uma proposta feita A UMA PESSOA. Ninguém mais precisa vê-lo,
        e principalmente ninguém mais pode aprová-lo: `_apply()` recusa quando
        `user_id` não é quem clicou. A regra abaixo é a mesma trava, um andar
        acima, para que um plano alheio nem apareça em lista.
    -->
    <record id="rule_capela_ai_plan_own" model="ir.rule">
        <field name="name">Plano do agente: só os próprios</field>
        <field name="model_id" ref="model_capela_ai_plan"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_capela_ai_plan_admin" model="ir.rule">
        <field name="name">Plano do agente: administrador enxerga todos</field>
        <field name="model_id" ref="model_capela_ai_plan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_capela_ai_plan_line_own" model="ir.rule">
        <field name="name">Operações do plano: acompanham o plano</field>
        <field name="model_id" ref="model_capela_ai_plan_line"/>
        <field name="domain_force">[('plan_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_capela_ai_plan_line_admin" model="ir.rule">
        <field name="name">Operações do plano: administrador enxerga todas</field>
        <field name="model_id" ref="model_capela_ai_plan_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

</odoo>
