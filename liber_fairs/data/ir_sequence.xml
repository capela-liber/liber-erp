<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- EV/2026/00001: o número do evento.
         NÃO é E00001. "E" com cinco dígitos se confunde com B0000 e C0000,
         que são documentos de pedido, e evento não é pedido: é o disparador
         de tudo o que vem depois (remessa, caixa, retorno, comissão), como a
         CO da consignação. A forma com barra e ano diz isso de longe, e é a
         mesma que vai para o analítico. -->
    <record id="seq_event_fair" model="ir.sequence">
        <field name="name">Event (EV)</field>
        <field name="code">event.fair</field>
        <field name="prefix">EV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
