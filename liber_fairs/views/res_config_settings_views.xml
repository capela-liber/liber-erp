<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fairs" model="ir.ui.view">
        <field name="name">res.config.settings.form.fairs</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='warehouse_setting_container']"
                   position="after">
                <block title="Events" name="fairs_setting_container">
                    <setting string="Analytic plan for events"
                             help="Where the analytic account of each event is created. It is what gathers, in one place, what the event cost and what it gave.">
                        <field name="fair_analytic_plan_id"/>
                    </setting>
                    <setting string="Service that pays the team"
                             help="The line used on the bill that pays daily rates and commission at the end of the event.">
                        <field name="fair_service_product_id"/>
                    </setting>
                    <setting string="Events responsible"
                             help="Who answers for the fairs team. Every new event starts with this person, and each event may change it.">
                        <field name="fair_manager_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
