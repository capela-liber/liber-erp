<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_line_tree_legacy" model="ir.ui.view">
        <field name="name">account.analytic.line.list.legacy</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="before">
                <field name="edlab_legacy_period" optional="hide"/>
                <field name="edlab_legacy_base" optional="hide"/>
                <field name="edlab_legacy_factor" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
